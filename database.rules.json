{
  "rules": {
    ".read": false,
    ".write": false,
    "leaderboards": {
      ".read": true,
      "$game": {
        ".write": true,
        ".indexOn": [
          "score"
        ]
      }
    },
    "xiangqiRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true,
        "chat": {
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    },
    "caroRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "connect4Rooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "tictactoeRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "reversiRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "morrisRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "goRooms": {
      ".read": true,
      ".indexOn": [
        "status"
      ],
      "$room": {
        ".write": true
      }
    },
    "xiangqiGameHistory": {
      ".read": true,
      "$owner": {
        ".write": true,
        "$game": {
          ".validate": "newData.hasChildren(['id', 'date', 'frames', 'moves'])"
        }
      }
    }
  }
}
